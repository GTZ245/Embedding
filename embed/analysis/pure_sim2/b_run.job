Executable      = b_run.csh 
Universe        = vanilla
Priority        = +20
Input           = /dev/null
GetEnv          = True
Log             = /dev/null
Output          = /dev/null
Error           = /dev/null
Initialdir      = $(PWD)
+Experiment     = "PHENIX"
+Job_Type       = "cas"
Notification    = Error

Arguments       = 0 $(Process) 0

Queue 10000
